{
  "description": "Core: compare DQN, Double DQN, PER and PPO trained on standard vs narrow physics.",
  "common": {
    "seeds": [0, 1, 2, 3, 4],
    "train_steps": 1000000,
    "validation_interval": 25000,
    "validation_episodes": 10,
    "validation_profiles": ["standard", "narrow"],
    "test_episodes": 100,
    "eval_profiles": ["standard", "narrow", "fast", "wind", "combined"],
    "max_episode_steps": 10000,
    "early_stopping_episodes": 0,
    "curriculum_fraction": 0.8,
    "learning_rate": 0.0001,
    "device": "auto",
    "torch_threads": 1
  },
  "experiments": [
    {
      "id": "fixed_standard",
      "methods": ["dqn", "double_dqn", "per_dqn", "ppo"],
      "train_profile": "standard",
      "train_strategy": "fixed"
    },
    {
      "id": "fixed_narrow",
      "methods": ["dqn", "double_dqn", "per_dqn", "ppo"],
      "train_profile": "narrow",
      "train_strategy": "fixed"
    }
  ]
}
