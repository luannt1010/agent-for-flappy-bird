{
  "description": "Independent placement study: Double DQN and PPO trained on standard vs surprise gap sequences.",
  "common": {
    "seeds": [0, 1, 2, 3, 4],
    "train_steps": 1000000,
    "validation_interval": 25000,
    "validation_episodes": 10,
    "validation_profiles": ["standard", "surprise"],
    "test_episodes": 100,
    "eval_profiles": ["standard", "surprise"],
    "max_episode_steps": 10000,
    "early_stopping_episodes": 0,
    "learning_rate": 0.0001,
    "device": "auto",
    "torch_threads": 1
  },
  "experiments": [
    {
      "id": "fixed_standard",
      "methods": ["double_dqn", "ppo"],
      "train_profile": "standard",
      "train_strategy": "fixed"
    },
    {
      "id": "fixed_surprise",
      "methods": ["double_dqn", "ppo"],
      "train_profile": "surprise",
      "train_strategy": "fixed"
    }
  ]
}
